# 複製為 .env 並填入實際值（.env 不會被 git 追蹤）

# 服務埠號（Render 會自動指定，本機開發用 5502）
PORT=5502

# 環境
NODE_ENV=development

# Apps Script 部署網址（藏在這裡，前端拿不到）
LIGHT_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# 後端 ↔ Apps Script 之間的共用密鑰（自訂一串隨機字串，雙方要一致）
LIGHT_SHARED_SECRET=請改成至少 32 字的隨機字串

# 活動報名 Apps Script
SIGNUP_APPS_SCRIPT_URL=https://script.google.com/macros/s/YYYYY/exec
SIGNUP_SHARED_SECRET=請改成另一串至少 32 字的隨機字串（與點燈不一樣）

# 允許跨域的前端網域，多個用逗號分隔
CORS_ORIGIN=https://sanchong-haichinggong.com,http://localhost:5500,http://127.0.0.1:5500
